{
  "manifest_version": 3,
  "name": "ZZZ Score Calculator",
  "version": "1.1.14",
  "description": "ゼンレスゾーンゼロ向けのスコア計算ツールです。",
  "content_scripts": [
    {
      "matches": ["https://act.hoyolab.com/*/*.html*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["public/images/*.png"],
      "matches": ["https://act.hoyolab.com/*"]
    }
  ]
}
